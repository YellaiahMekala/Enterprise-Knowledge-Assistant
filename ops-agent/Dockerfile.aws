# The agent image for AWS: the same build as Dockerfile, with the runbooks baked in (on Compose
# they are mounted). Build from the repository root:
#   docker build -f ops-agent/Dockerfile.aws -t eka-ops-agent .
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY ops-agent/pom.xml .
RUN mvn -B -q dependency:go-offline
COPY ops-agent/src src
RUN mvn -B -q package -DskipTests

FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10002 opsagent
WORKDIR /app
COPY --from=build /build/target/eka-ops-agent-*.jar app.jar
COPY docs/runbooks.md /app/runbooks.md
USER opsagent
EXPOSE 8090
ENTRYPOINT ["java", "-jar", "app.jar"]
