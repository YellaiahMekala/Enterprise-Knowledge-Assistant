// Ships the logs of this compose project's containers to Loki, labelled by compose service name
// (service="api", "worker", "core-behind-edge", ...). The ops agent searches by that label.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "compose" {
  targets = discovery.docker.containers.targets

  // Only containers started by compose, and only from this project.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = sys.env("COMPOSE_PROJECT")
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.compose.output
  relabel_rules = discovery.relabel.compose.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
