    {
      "name": "03 Search (needs a ready document)",
      "item": [
        {
          "name": "S0 Setup: upload and wait",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted', () => pm.expect(pm.response.code).to.be.oneOf([200, 202]));",
                  "pm.collectionVariables.set('searchDocId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{userKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "eval/corpus/expense_policy.md"
                }
              ]
            }
          }
        },
        {
          "name": "S0b Setup: wait until ready",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Poll without sleeping: spin for one second, then the test below re-queues this request.",
                  "const t = Date.now(); while (Date.now() - t < 1000) {}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = pm.response.json().status;",
                  "const n = Number(pm.collectionVariables.get('waitCount') || 0) + 1;",
                  "pm.collectionVariables.set('waitCount', n);",
                  "if ((s === 'pending' || s === 'processing') && n < 60) { pm.execution.setNextRequest(pm.info.requestName); } else { pm.collectionVariables.set('waitCount', 0); }",
                  "pm.test('final status', () => pm.expect(s).to.be.oneOf(['ready', 'failed', 'pending', 'processing']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{userKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents/{{searchDocId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "{{searchDocId}}"
              ]
            }
          }
        },
        {
          "name": "S1 Search",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('echoes the query', () => pm.expect(j.query).to.eql('Is alcohol reimbursable?'));",
                  "pm.test('ranked results with scores', () => { pm.expect(j.results.length).to.be.above(0); pm.expect(j.results[0].rank).to.eql(1); pm.expect(j.results[0].scores.cosine).to.be.a('number'); });",
                  "pm.test('best passage is from the expense policy', () => pm.expect(j.results[0].filename).to.eql('expense_policy.md'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{userKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "search"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Is alcohol reimbursable?\",\n  \"top_k\": 3\n}"
            }
          }
        },
        {
          "name": "S2 Search with a filter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('only that document', () => pm.response.json().results.forEach(r => pm.expect(r.document_id).to.eql(pm.collectionVariables.get('searchDocId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{userKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "search"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"approval limits\",\n  \"top_k\": 3,\n  \"filters\": {\n    \"document_ids\": [\n      \"{{searchDocId}}\"\n    ]\n  }\n}"
            }
          }
