          "name": "C1 Create: upload a file",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 new, or 200 if the same bytes were uploaded before', () => pm.expect(pm.response.code).to.be.oneOf([200, 202]));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('documentId', j.id);",
                  "pm.test('has id and filename', () => { pm.expect(j.id).to.be.a('string'); pm.expect(j.filename).to.eql('leave_policy.md'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
