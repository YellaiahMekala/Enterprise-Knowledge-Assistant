{
  "info": {
    "name": "EKA manual testing: CRUD walkthrough",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Hands-on collection for the core API: documents and conversations create/read/list/delete, search, chat, admin and the main error cases. Needs the database, the worker and the API running. Run from the repository root. Use the fake chat model (default) for free runs."
  },
  "item": [
    {
      "name": "00 Health (no key)",
      "item": [
        {
          "name": "Live",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            }
          }
        },
        {
          "name": "Ready (database answers)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
