                  "pm.test('ready with chunks', () => { pm.expect(j.status).to.eql('ready'); pm.expect(j.chunk_count).to.be.above(0); });",
                  "pm.test('fields', () => { pm.expect(j.content_type).to.be.a('string'); pm.expect(j.size_bytes).to.be.above(0); });"
                ]
              }
            }
