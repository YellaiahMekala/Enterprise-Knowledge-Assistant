        {
          "name": "R1 Read: wait until the worker finished",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Poll without sleeping: spin for one second, then the test below re-queues this request.",
                  "const t = Date.now(); while (Date.now() - t < 1000) {}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = pm.response.json().status;",
                  "const n = Number(pm.collectionVariables.get('waitCount') || 0) + 1;",
                  "pm.collectionVariables.set('waitCount', n);",
                  "if ((s === 'pending' || s === 'processing') && n < 60) { pm.execution.setNextRequest(pm.info.requestName); } else { pm.collectionVariables.set('waitCount', 0); }",
                  "pm.test('reached a final status', () => pm.expect(s).to.be.oneOf(['ready', 'failed', 'pending', 'processing']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{userKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents/{{documentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "{{documentId}}"
              ]
            },
            "description": "The worker parses, chunks and embeds in the background. This request repeats itself (up to 60 s) until status is ready or failed."
          }
        },
