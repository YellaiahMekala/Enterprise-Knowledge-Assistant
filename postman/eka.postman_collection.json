{
  "info": {
    "name": "Enterprise Knowledge Assistant",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contract checks for the core API. Folders without 'needs the database' run against a core started in test mode."
  },
  "variable": [
    {
      "key": "conversationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health is public",
      "item": [
        {
          "name": "Live",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Me with a valid key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has user id and role', () => { const b = pm.response.json(); pm.expect(b.user_id).to.be.a('string'); pm.expect(b.role).to.be.oneOf(['user','admin']); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            }
          }
        },
        {
          "name": "Me without a key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
                  "pm.test('problem type', () => pm.expect(pm.response.json().type).to.eql('urn:eka:problem:unauthorized'));",
                  "pm.test('request id matches header', () => pm.expect(pm.response.json().request_id).to.eql(pm.response.headers.get('X-Request-Id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            }
          }
        },
        {
          "name": "Me with a wrong key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
                  "pm.test('problem type', () => pm.expect(pm.response.json().type).to.eql('urn:eka:problem:unauthorized'));",
                  "pm.test('request id matches header', () => pm.expect(pm.response.json().request_id).to.eql(pm.response.headers.get('X-Request-Id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "not-a-real-key"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Authorization",
      "item": [
        {
          "name": "Admin status with a user key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 403', () => pm.response.to.have.status(403));",
                  "pm.test('problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
                  "pm.test('problem type', () => pm.expect(pm.response.json().type).to.eql('urn:eka:problem:forbidden'));",
                  "pm.test('request id matches header', () => pm.expect(pm.response.json().request_id).to.eql(pm.response.headers.get('X-Request-Id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{userKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "status"
              ]
            }
          }
        },
        {
          "name": "Admin metrics with a user key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 403', () => pm.response.to.have.status(403));",
                  "pm.test('problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
                  "pm.test('problem type', () => pm.expect(pm.response.json().type).to.eql('urn:eka:problem:forbidden'));",
                  "pm.test('request id matches header', () => pm.expect(pm.response.json().request_id).to.eql(pm.response.headers.get('X-Request-Id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{userKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "metrics"
              ]
            }
          }
        },
        {
          "name": "Admin status with an admin key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('build info', () => pm.expect(pm.response.json()).to.have.keys('version','environment','auth_mode','uptime_seconds'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "status"
              ]
            }
          }
        },
        {
          "name": "Admin metrics are Prometheus text",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('exposition format', () => pm.expect(pm.response.text()).to.include('eka_http_requests_total'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "metrics"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Documents (needs the database)",
      "item": [
        {
          "name": "List documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('list shape', () => pm.expect(pm.response.json().items).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents"
              ]
            }
          }
        },
        {
          "name": "Unknown document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
                  "pm.test('problem type', () => pm.expect(pm.response.json().type).to.eql('urn:eka:problem:not-found'));",
                  "pm.test('request id matches header', () => pm.expect(pm.response.json().request_id).to.eql(pm.response.headers.get('X-Request-Id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "00000000-0000-0000-0000-000000000000"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Search and chat (need the database and ingested documents)",
      "item": [
        {
          "name": "Search",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('results array', () => pm.expect(pm.response.json().results).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "search"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"query\": \"How many days of annual leave do employees get?\", \"top_k\": 3}"
            }
          }
        },
        {
          "name": "Chat answers with citations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('answer shape', () => { const b = pm.response.json(); pm.expect(b.answer).to.be.a('string'); pm.expect(b.citations).to.be.an('array'); pm.expect(b.refused).to.be.a('boolean'); });",
                  "pm.collectionVariables.set('conversationId', pm.response.json().conversation_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"question\": \"How many days of annual leave do employees get?\"}"
            }
          }
        },
        {
          "name": "Conversation is readable",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has messages', () => pm.expect(pm.response.json().messages.length).to.be.at.least(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/{{conversationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "conversations",
                "{{conversationId}}"
              ]
            }
          }
        },
        {
          "name": "Delete the conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/{{conversationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "conversations",
                "{{conversationId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}