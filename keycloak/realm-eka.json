{
  "realm": "eka",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [{ "name": "eka-admin", "description": "Can read the admin endpoints" }]
  },
  "clients": [
    {
      "clientId": "eka-ui",
      "name": "EKA web UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "audience-eka-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "eka-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-as-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "8a5f1d2e-0c3b-4f6a-9d7e-2b1c4a6e8f01",
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "${KC_ALICE_PASSWORD}", "temporary": false }]
    },
    {
      "id": "8a5f1d2e-0c3b-4f6a-9d7e-2b1c4a6e8f02",
      "username": "boss",
      "enabled": true,
      "email": "boss@example.test",
      "emailVerified": true,
      "firstName": "Boss",
      "lastName": "Admin",
      "realmRoles": ["eka-admin"],
      "credentials": [{ "type": "password", "value": "${KC_BOSS_PASSWORD}", "temporary": false }]
    }
  ]
}
