# Copy to .env (git-ignored) and fill in the marked values. Never commit .env.

# local | test | prod  (prod hides /docs, /redoc and /openapi.json)
EKA_ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
EKA_LOG_LEVEL=INFO
# true = one JSON object per log line (the Docker image defaults to true)
EKA_LOG_JSON=false

# --- Database (docker compose db service) ---
# CHANGE ME: a password of your own. Use letters and digits only: it is placed inside a URL.
EKA_DB_PASSWORD=
# Host port for the compose database (loopback only).
EKA_DB_PORT=5432
# Used when the API or Alembic runs on the host (not inside compose). Must repeat the password.
EKA_DATABASE_URL=postgresql+psycopg://eka:<EKA_DB_PASSWORD>@127.0.0.1:5432/eka

# --- Authentication (standalone API-key mode) ---
EKA_AUTH_MODE=api_key
# One entry per caller: the SHA-256 digest of the key, never the key. Create both with
#   python -m eka.tools.hash_key --generate
# and keep the key itself in your own secret store. Single quotes keep the JSON intact.
EKA_API_KEYS='{"alice": {"sha256": "<64 hex characters>", "role": "user"}}'

# Edge profile (docker compose --profile edge up)
EKA_EDGE_PSEUDONYM_SECRET=
EKA_EDGE_OIDC_ISSUER=
EKA_EDGE_OIDC_JWK_SET_URI=

# Monitoring profile
EKA_GRAFANA_PASSWORD=

# Keycloak test identity provider (compose profile idp); choose any values for local use
EKA_KEYCLOAK_ADMIN_PASSWORD=
EKA_KEYCLOAK_ALICE_PASSWORD=
EKA_KEYCLOAK_BOSS_PASSWORD=

# File storage: local (default) or s3. Keys are optional on AWS (a task or instance role works).
EKA_STORAGE_BACKEND=local
EKA_S3_BUCKET=
EKA_S3_REGION=
EKA_S3_ENDPOINT_URL=
EKA_S3_ACCESS_KEY_ID=
EKA_S3_SECRET_ACCESS_KEY=

# Alerting: the triage agent emails a report. Local default is the Mailpit catcher (compose profile agent).
# For real mail use an SMTP account (for Gmail an app password) and set EKA_ALERT_SMTP_AUTH=true.
OPS_AGENT_WEBHOOK_TOKEN=
EKA_ALERT_EMAIL_TO=
EKA_ALERT_EMAIL_FROM=
EKA_ALERT_SMTP_HOST=
EKA_ALERT_SMTP_PORT=
EKA_ALERT_SMTP_USER=
EKA_ALERT_SMTP_PASSWORD=
EKA_ALERT_SMTP_AUTH=

# Chat provider: fake (default), openai, or bedrock (AWS credential chain; EKA_CHAT_MODEL is the model id)
EKA_BEDROCK_REGION=
# Leave empty for real AWS. Only for the local stand-in: http://127.0.0.1:8765 (python -m eka.tools.bedrock_stub)
# with AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY set to any fake value.
EKA_BEDROCK_ENDPOINT_URL=

# Optional web fallback (ADR-030). Off by default. Exact host names only; entry URLs must be https
# on those hosts (1 to 10). Pages are fetched only when your documents give weak evidence, stored as
# your documents, and cited with their URL and fetch date.
EKA_WEB_FALLBACK_ENABLED=false
EKA_WEB_ALLOWED_HOSTS=[]
EKA_WEB_ENTRY_URLS=[]
# Pages linked from each entry page to fetch too (0 to 20; same directory only, robots.txt respected).
EKA_WEB_MAX_LINKED_PAGES=0

# Triage agent log search on AWS: the log group from `terraform output log_group` (empty uses Loki).
# OPS_AGENT_CLOUDWATCH_ENDPOINT_URL is only for a local stand-in such as LocalStack.
OPS_AGENT_CLOUDWATCH_LOG_GROUP=
OPS_AGENT_CLOUDWATCH_ENDPOINT_URL=

# Traces (NFR-07). Off unless set. Start the viewer with: docker compose --profile monitoring up -d jaeger
# EKA_OTEL_ENDPOINT=http://jaeger:4318
# EKA_OTEL_SAMPLE_RATIO=1.0
# Shared rate limit for several edge replicas (empty: in memory, per replica).
# EKA_EDGE_RATE_LIMIT_REDIS_URL=redis://redis:6379
# EKA_EDGE_OTEL_ENABLED=true
